# ===== 模型配置（必填）=====
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 小模型（用于意图分类、摘要，省钱）
SMALL_MODEL=gpt-4o-mini

# ===== 追踪（可选，强烈建议开发期打开）=====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-xxxx
# LANGSMITH_PROJECT=agent-learning

# ===== 嵌入模型（04 / 11 用）=====
# 二选一：本地 sentence-transformers 或 API
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-m3
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small

# ===== 数据库（08 / 11 / 12 用）=====
# 没有 Postgres 时留空，代码会自动用 InMemorySaver
PG_URI=postgresql://postgres:postgres@localhost:5432/agent

# ===== 业务 API（12 用）=====
ORDER_API=http://localhost:8080/api
